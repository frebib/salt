images:
  - name: salt-bullseye-base
    version_file: VERSION
    dockerfile: base/Dockerfile
    context: ..
    build_arguments:
      DEBIAN_RELEASE: bullseye

  # master-base image derived from salt-bullseye-base
  - name: salt-bullseye-master
    version_file: VERSION
    dockerfile: master/Dockerfile
    context: ..
    build_arguments:
      DEBIAN_RELEASE: bullseye

  # minion-base image derived from salt-bullseye-base
  - name: salt-bullseye-minion
    version_file: VERSION
    dockerfile: minion/Dockerfile
    context: ..
    build_arguments:
      DEBIAN_RELEASE: bullseye
